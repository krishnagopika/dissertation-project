# ---------------------------------------------------------------------------
# Server-side only. Nothing here is NEXT_PUBLIC_, so nothing reaches the
# browser: every call to Modal goes through app/api/modal/route.ts, which
# holds the credentials. With MODAL_KEY client-side, any visitor could pin a
# GPU container at your expense.
#
# Local:  cp .env.example .env.local
# Vercel: Project Settings -> Environment Variables (Production, Preview, Dev)
# ---------------------------------------------------------------------------

# --- Modal endpoints ---------------------------------------------------------
# These are the live URLs from `modal deploy src/modal/serve_emotion.py`,
# already deployed in workspace krishnagopika1701. Change the workspace prefix
# if you redeploy under another account.
MODAL_CLASSIFY_URL=https://krishnagopika1701--xlm-voxemotion-emotionpipeline-classify.modal.run
MODAL_CLIPS_URL=https://krishnagopika1701--xlm-voxemotion-clips.modal.run
MODAL_CLIP_URL=https://krishnagopika1701--xlm-voxemotion-clip.modal.run
MODAL_ADMIN_URL=https://krishnagopika1701--xlm-voxemotion-admin.modal.run

# --- Modal proxy auth --------------------------------------------------------
# Modal dashboard -> Settings -> Proxy Auth Tokens -> Create. Sent as the
# Modal-Key / Modal-Secret headers on every request. The endpoints are
# declared with requires_proxy_auth=True, so without these every call 401s.
MODAL_KEY=
MODAL_SECRET=

# --- Auth.js -----------------------------------------------------------------
# Signing key for the session cookie. Generate with:  npx auth secret
AUTH_SECRET=

# Vercel sets this for you in production. Needed locally so OAuth callbacks
# come back to the right origin.
# AUTH_URL=http://localhost:3000

# At least ONE identity provider. Both are free with no user cap.
#
# Google:  console.cloud.google.com -> APIs & Services -> Credentials ->
#          Create OAuth client ID -> Web application.
#          Authorised redirect URI:
#            https://<your-app>.vercel.app/api/auth/callback/google
#            http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub:  github.com/settings/developers -> New OAuth App.
#          Authorisation callback URL:
#            https://<your-app>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# WorkOS:  dashboard.workos.com
#            AUTH_WORKOS_ID     = Client ID      (client_...)
#            AUTH_WORKOS_SECRET = API Key        (sk_...)
#          Redirect URI, registered under Redirects:
#            https://<your-app>.vercel.app/api/auth/callback/workos
#            http://localhost:3000/api/auth/callback/workos
#
#          Leave AUTH_WORKOS_CONNECTION EMPTY to use AuthKit, WorkOS's hosted
#          sign-in page (social, password, magic link). That is the free,
#          high-MAU product and needs nothing but the two values above.
#
#          Set AUTH_WORKOS_CONNECTION to a connection id (conn_...) instead to
#          use enterprise SSO -- SAML or a directory-backed IdP. The two are
#          different endpoints, so this variable is the switch between them.
AUTH_WORKOS_ID=
AUTH_WORKOS_SECRET=
AUTH_WORKOS_CONNECTION=

# --- Access control ----------------------------------------------------------
# Comma-separated, case-insensitive.
#
# ALLOWED_EMAILS gates sign-in. An EMPTY list denies everyone rather than
# admitting everyone -- a deployment that forgets to set it should lock its
# owner out, not open a GPU to the internet.
ALLOWED_EMAILS=

# ADMIN_EMAILS gates the Keep warm / Stop controls, which pin a container that
# bills continuously. Should be a subset of ALLOWED_EMAILS, usually just you.
ADMIN_EMAILS=

# --- Run log (optional) ------------------------------------------------------
# Supabase Postgres, reached over PostgREST rather than a Postgres driver:
# Vercel Functions are short-lived and numerous, and a TCP pool per invocation
# is how you exhaust a connection limit. HTTPS has no pool to exhaust.
#
# Create the table first: paste supabase/001_analysis_runs.sql into the
# Supabase SQL editor. Leave these unset and the app falls back to
# browser-local history with no loss of function.
#
# The SECRET key, not the publishable one: the table has RLS enabled with no
# policies, so only a key that bypasses RLS can read or write it. Never expose
# this to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
