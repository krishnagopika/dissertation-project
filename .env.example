# ---------------------------------------------------------------------------
# XLM-VoxEmotion — environment template
#
#   cp .env.example .env      then edit the four ROOT paths below
#   bash setup/configure_paths.sh    rewrites the scripts to match
#
# Everything in this project reads its paths from these variables. The four
# roots are the only ones you must set; the rest are derived from them and are
# listed so you can see where things land.
# ---------------------------------------------------------------------------

# --- The four you must change -----------------------------------------------

# Where this repository is checked out.
PROJECT_ROOT=/absolute/path/to/dissertation-project

# Corpora, caches and extracted features. Needs ~30 GB free:
#   meld_raw 11G · ravdess 566M · dialect_probe_full 3.5G · derived caches ~12G
DATA_ROOT=/absolute/path/to/data

# Model checkpoints. Needs ~20 GB for the full grid; a single run is ~50 MB.
CKPT_ROOT=/absolute/path/to/checkpoints

# HuggingFace cache. Voxtral-Mini is ~9 GB, Voxtral-Small ~48 GB, XLM-R ~1 GB.
HF_HOME=/absolute/path/to/hf_cache

# Python 3.12 virtualenv created by setup/install.sh
VENV=/absolute/path/to/venv


# --- Credentials -------------------------------------------------------------

# Required: Voxtral and XLM-RoBERTa are gated/large downloads.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional. Only needed to reproduce the Voxtral-Small comparison, which does
# not fit two 48 GB cards (48.5 GB in bf16) and ran on a single A100-80GB.
# Everything else runs on one 48 GB GPU. https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROFILE=


# --- Derived layout (created by setup/download_data.sh; no need to edit) -----
#
#   $DATA_ROOT/meld_raw/              MELD as distributed: train/ dev/ test/
#                                     and *_sent_emo.csv label files
#   $DATA_ROOT/ravdess/               RAVDESS, Actor_01 … Actor_24
#   $DATA_ROOT/dialect_probe_full/    audio/ + manifest.csv + annotations
#
#   ... everything below is GENERATED by the pipeline, not downloaded ...
#
#   $DATA_ROOT/meld_transcripts/      Voxtral ASR output          (step 1)
#   $DATA_ROOT/meld_extracted/        frame-level acoustic cache  (step 1)
#   $DATA_ROOT/meld_filter_metadata/  WER + VAD per utterance     (step 2)
#   $DATA_ROOT/meld_filter_keys/      defect keep-lists           (step 2)
#   $DATA_ROOT/meld_text_emb_v2/      XLM-R embeddings per cond.  (step 3)
#   $DATA_ROOT/meld_pooled/           attention-pooled, projected (step 5)
#   $DATA_ROOT/meld_pooled_raw/       attention-pooled, 1280-d    (step 5)
#   $DATA_ROOT/meld_fused/            fused vectors for stacking  (step 5)
